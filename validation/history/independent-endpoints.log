def RankCertificates.HasExactRank : WeierstrassCurve.{0} ℚ → ℕ → Prop :=
fun E r => Eq.{2} (RankCertificates.rationalRank E) ↑r
def RankCertificates.InfinitelyManyExactRank : ℕ → Prop :=
