                Membership.mem.{0, 0} (RankCertificates.twoIsogenyImage a b) q → Eq.{1} (f (Additive.ofMul.{0} q)) 0) →
      LE.le.{0} (Nat.card.{0} ↑(RankCertificates.twoIsogenyImage a b))
        (Nat.card.{0} ↥(RankCertificates.Binary.kernelSubmodule n rows))
