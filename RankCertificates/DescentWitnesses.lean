module

public import RankCertificates.Kummer
public import RankCertificates.Integration
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Actual rational-point witnesses for the binary descent generators

The points here inhabit mathlib's genuine affine rational-point group. Each
of the 24 masks in the three pairs of certificates is proved to occur in the
actual two-isogeny squareclass image on the specified congruence lattice.
The subgroup generated by these witnessed classes lies in the actual image.
No prime independence, local upper bound, rank formula, or analytic
infinitude is asserted.
-/

@[expose] public section

namespace RankCertificates.DescentWitnesses

/-- Turn a certified affine equation into an actual rational group point. -/
def pointOfOnCurve {a b x y : ℚ} (hΔ : (twoTorsionModel a b).Δ ≠ 0)
    (h : OnCurve a b x y) : (twoTorsionModel a b).toAffine.Point :=
  .some x y (by
    simpa only [twoTorsionModel, model] using onCurve_nonsingular hΔ h)

@[simp] theorem class_pointOfOnCurve {a b x y : ℚ}
    (hΔ : (twoTorsionModel a b).Δ ≠ 0) (h : OnCurve a b x y) :
    twoIsogenyClass a b (pointOfOnCurve hΔ h) =
      if x = 0 then rationalSquareClass b else rationalSquareClass x := rfl

/-- The rational two-torsion point `(0,0)` in the genuine point group. -/
def torsionPoint {a b : ℚ} (hΔ : (twoTorsionModel a b).Δ ≠ 0) :
    (twoTorsionModel a b).toAffine.Point :=
  pointOfOnCurve (x := 0) (y := 0) hΔ (by simp [OnCurve])

@[simp] theorem class_torsionPoint {a b : ℚ}
    (hΔ : (twoTorsionModel a b).Δ ≠ 0) :
    twoIsogenyClass a b (torsionPoint hΔ) = rationalSquareClass b := by
  simp [torsionPoint]

/-- Nonzero-coordinate points are in the actual Kummer kernel exactly when
that coordinate is a nonzero rational square. -/
theorem pointOfOnCurve_mem_kernel_iff {a b x y : ℚ} (hb : b ≠ 0)
    (hΔ : (twoTorsionModel a b).Δ ≠ 0) (h : OnCurve a b x y) (hx : x ≠ 0) :
    pointOfOnCurve hΔ h ∈ (twoIsogenyClassAddHom a b hb).ker ↔
      ∃ r : ℚ, r ≠ 0 ∧ x = r ^ 2 := by
  change twoIsogenyClass a b (pointOfOnCurve hΔ h) = 1 ↔ _
  rw [class_pointOfOnCurve, ite_eq_right hx, rationalSquareClass_eq_one_iff hx]

/-- The zero-coordinate torsion point is in the Kummer kernel exactly when
`b` is a nonzero rational square. -/
theorem torsionPoint_mem_kernel_iff {a b : ℚ} (hb : b ≠ 0)
    (hΔ : (twoTorsionModel a b).Δ ≠ 0) :
    torsionPoint hΔ ∈ (twoIsogenyClassAddHom a b hb).ker ↔
      ∃ r : ℚ, r ≠ 0 ∧ b = r ^ 2 := by
  change twoIsogenyClass a b (torsionPoint hΔ) = 1 ↔ _
  rw [class_torsionPoint, rationalSquareClass_eq_one_iff hb]

/-- Every mask value is nonzero when its ordered columns are nonzero. -/
theorem maskValueFrom_ne_zero (code offset : ℕ) (columns : List ℚ)
    (h : ∀ c ∈ columns, c ≠ 0) : Integration.maskValueFrom code offset columns ≠ 0 := by
  induction columns generalizing offset with
  | nil => simp [Integration.maskValueFrom]
  | cons c cs ih =>
    simp only [Integration.maskValueFrom]
    apply mul_ne_zero
    · split_ifs
      · exact h c (by simp)
      · exact one_ne_zero
    · exact ih _ (fun q hq => h q (by simp [hq]))

theorem maskValue_ne_zero (code : ℕ) (columns : List ℚ)
    (h : ∀ c ∈ columns, c ≠ 0) : Integration.maskValue columns code ≠ 0 :=
  maskValueFrom_ne_zero code 0 columns h

/-- Products and inverses of witnessed point classes also lie in the
actual image, because the coordinate rule is a proved homomorphism. -/
theorem closure_le_actual_image {a b : ℚ} (hb : b ≠ 0)
    (s : Set RationalSquareClasses) (hs : s ⊆ twoIsogenyImage a b) :
    (Subgroup.closure s : Set RationalSquareClasses) ⊆ twoIsogenyImage a b := by
  rw [twoIsogenyImage_eq_subgroup a b hb] at hs ⊢
  exact (Subgroup.closure_le _).mpr hs

theorem elliptic5E_on_lattice (x y : ℤ) : (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).IsElliptic := by
  simpa only [twoTorsionModel, Rank5.E, model] using
    (Integration.elliptic_pair5_on_lattice x y).1

theorem discriminant5E_ne_zero (x y : ℤ) : (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).Δ ≠ 0 := by
  let : (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).IsElliptic := elliptic5E_on_lattice x y
  exact (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).isUnit_Δ.ne_zero

/-- Actual rational points for the `5E` known generators, including `(0,0)`. -/
def witnesses5E (x y : ℤ) : Fin 3 → (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).toAffine.Point :=
  ![torsionPoint (discriminant5E_ne_zero x y), pointOfOnCurve (discriminant5E_ne_zero x y) (Rank5.P1_onCurve (Integration.M5 x) (Integration.N5 y)), pointOfOnCurve (discriminant5E_ne_zero x y) (Rank5.P2_onCurve (Integration.M5 x) (Integration.N5 y))]

theorem outputs5_nonzero (x y : ℤ) (i : Fin 12) : Integration.outputs5 x y i ≠ 0 := by
  intro hi
  have h := Integration.forms5_nonzero_on_lattice x y i
  rw [Integration.normalization5, hi, mul_zero] at h
  exact h rfl

theorem columns5E_nonzero (x y : ℤ) :
    ∀ c ∈ Integration.columns5E (Integration.outputs5 x y), c ≠ 0 := by
  simp [Integration.columns5E, outputs5_nonzero]

theorem masks5E_nonzero (x y : ℤ) (i : Fin 3) :
    Integration.maskValue (Integration.columns5E (Integration.outputs5 x y))
      (Integration.codes5E i) ≠ 0 :=
  maskValue_ne_zero _ _ (columns5E_nonzero x y)

theorem coordinates5E_nonzero (x y : ℤ) (i : Fin 3) :
    Integration.coordinates5E (Integration.M5 x) (Integration.N5 y) i ≠ 0 := by
  rw [Integration.point_masks5E_on_lattice]
  exact mul_ne_zero (masks5E_nonzero x y i)
    (pow_ne_zero 2 (Integration.squareFactors5E_nonzero i))

/-- The witnessed classes equal the prescribed actual point coordinates. -/
theorem witnesses5E_coordinate_classes (x y : ℤ) (i : Fin 3) :
    twoIsogenyClass (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y)) (witnesses5E x y i) =
      rationalSquareClass (Integration.coordinates5E (Integration.M5 x) (Integration.N5 y) i) := by
  have hc := coordinates5E_nonzero x y i
  fin_cases i <;>
    simp [witnesses5E, Integration.coordinates5E] at hc ⊢ <;>
    simp [hc]

/-- Each literal binary generator represents a class in the actual image. -/
theorem witnesses5E_mask_classes (x y : ℤ) (i : Fin 3) :
    twoIsogenyClass (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y)) (witnesses5E x y i) =
      rationalSquareClass (Integration.maskValue
        (Integration.columns5E (Integration.outputs5 x y)) (Integration.codes5E i)) := by
  rw [witnesses5E_coordinate_classes, Integration.point_masks5E_on_lattice]
  exact rationalSquareClass_mul_square (masks5E_nonzero x y i)
    (Integration.squareFactors5E_nonzero i)

theorem knownclasses5E_mem_actual_image (x y : ℤ) (i : Fin 3) :
    rationalSquareClass (Integration.maskValue
      (Integration.columns5E (Integration.outputs5 x y)) (Integration.codes5E i)) ∈
        twoIsogenyImage (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y)) :=
  ⟨witnesses5E x y i, witnesses5E_mask_classes x y i⟩

theorem knownclasses5E_closure_le_actual_image (x y : ℤ) :
    (Subgroup.closure (Set.range (fun i : Fin 3 => rationalSquareClass
      (Integration.maskValue (Integration.columns5E (Integration.outputs5 x y))
        (Integration.codes5E i)))) : Set RationalSquareClasses) ⊆
      twoIsogenyImage (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y)) := by
  apply closure_le_actual_image
    (by let : (twoTorsionModel (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y))).IsElliptic := elliptic5E_on_lattice x y
        exact twoTorsion_b_ne_zero (Rank5.a (Integration.M5 x) (Integration.N5 y)) (Rank5.b (Integration.M5 x) (Integration.N5 y)))
  rintro c ⟨i, rfl⟩
  exact knownclasses5E_mem_actual_image x y i

